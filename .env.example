# Public values, read by the browser (Neon > project > Connect > Auth / Data API)
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.region.aws.neon.tech/neondb/rest/v1

# Optional: shows a "Try the demo account" button on the login form
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Secret, only for the scripts in scripts/ (never prefix with VITE_). `neon deploy` writes these:
# DATABASE_URL_UNPOOLED=postgresql://...
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
